      <div xml:id="gom-tob12">
        <head xml:id="gom-tob12-Hd1e98">Caput 12</head>
        <div xml:id="gom-tob12-Dd1e100">
          <head xml:id="gom-tob12-Hd1e102">Versus 14</head>
          <p xml:id="gom-tob12-d1e104">
            <pb ed="#P" n="0731C"/>
            <quote xml:id="gom-tob12-Qd1e108" type="lemma" source="http://scta.info/resource/tob12_14@1-2">Et nunc,</quote>
            etc.
            <ref xml:id="gom-tob12-Rd1e111"><name xml:id="gom-tob12-Nd1e112" ref="#Bede">BEDA</name>, in Tobiam.</ref>
            <quote xml:id="gom-tob12-Qd1e116">Rediturus in coelum angelus apertius quid sit et quare venerit, et quo reversurus sit exponit: et Christus eidem populo latius proficienti conditionem suam patefecit, ostendens, quod ipse in Patre, et <pb ed="#P" n="0732A"/> Pater in Filio sit. Angelus redit ad Deum, Tobias remanet apud Patrem, et Christus a fidelibus suis intelligitur divinitate Patri aequalis, humanitate hominibus consubstantialis.</quote>
          </p>
        </div>
      </div>
