      <div xml:id="gom-ios18">
        <head xml:id="gom-ios18-Hd1e98">Caput 18</head>
        <div xml:id="gom-ios18-Dd1e100">
          <head xml:id="gom-ios18-Hd1e102">Versus 6</head>
          <p xml:id="gom-ios18-d1e104">
            <quote xml:id="gom-ios18-Qd1e106" type="lemma" source="http://scta.info/resource/ios18_6@19-20">Mittam vobis.</quote>
            <ref xml:id="gom-ios18-Rd1e109"><name xml:id="gom-ios18-Nd1e110" ref="#Origen">ADAM.</name>, hom. 23 in Jos.</ref>
            <quote xml:id="gom-ios18-Qd1e114"><seg type="qs">In consuetudine hominum</seg>, etc., usque ad <seg type="qs">ut non alii daretur terrestris, quae est figura coelestis</seg></quote>
          </p>
          <p xml:id="gom-ios18-d1e122">
            <ref xml:id="gom-ios18-Rd1e124" type="lemma" subtype="implied" target="http://scta.info/resource/ios18_6@19-20"/>
            <ref xml:id="gom-ios18-Rd1e126"><name xml:id="gom-ios18-Nd1e127" ref="#Origen">ID.</name>, hom. 23.</ref>
            <quote xml:id="gom-ios18-Qd1e131"><seg type="qs">Bethlehem quoque non sine certa <pb ed="#P" n="0519B"/> ratione in fontem Judae discernitur</seg>, etc., usque ad <seg type="qs">Unde Timotheo ait: <quote xml:id="gom-ios18-Qd1e139" source="http://scta.info/resource/IItim2_2@10-18">Memor esto verborum quae commendo fidelibus hominibus, et his qui idonei sunt alios docere</quote>.</seg></quote>
          </p>
        </div>
      </div>
    </body>
