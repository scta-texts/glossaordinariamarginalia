    <body>
      <div xml:id="gom-deut9">
        <head xml:id="gom-deut9-Hd1e98">Caput 9</head>
        <div xml:id="gom-deut9-Dd1e100">
          <head xml:id="gom-deut9-Hd1e102">Versus 5</head>
          <p xml:id="gom-deut9-d1e104">
            <pb ed="#P" n="0462A"/>
            <quote xml:id="gom-deut9-Qd1e108" type="lemma" source="http://scta.info/resource/deut9_5@1-2">Neque enim,</quote>
            etc.
            <ref xml:id="gom-deut9-Rd1e111"><name xml:id="gom-deut9-Nd1e112" ref="#Augustine">AUG.</name>, quaest. 14.</ref>
            <quote xml:id="gom-deut9-Qd1e116"><seg type="qs">Isti sunt qui non meruerunt perire in deserto</seg>, etc., usque ad <seg type="qs">ubi illi exacerbaverunt Dominum, qui merito suo in terram promissionis introducti non sunt.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-deut9-Dd1e125">
          <head xml:id="gom-deut9-Hd1e127">Versus 10</head>
          <p xml:id="gom-deut9-d1e129">
            <quote xml:id="gom-deut9-Qd1e131" type="lemma" source="http://scta.info/resource/deut9_10@1-1">Deditque,</quote>
            etc.
            <ref xml:id="gom-deut9-Rd1e134"><name xml:id="gom-deut9-Nd1e135" ref="#Augustine">AUG.</name>, quaest. 15.</ref>
            <quote xml:id="gom-deut9-Qd1e139"><seg type="qs">In Exodo legitur quod tabulas Moysi Dominus dederit</seg>, etc., usque ad <seg type="qs">durat in saeculum.</seg></quote>
          </p>
        </div>
      </div>
    </body>
