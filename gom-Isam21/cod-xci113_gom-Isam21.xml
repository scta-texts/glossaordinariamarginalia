    <body>
      <div xml:id="gom-Isam21">
        <head xml:id="gom-Isam21-Hd1e98">Caput 21</head>
        <div xml:id="gom-Isam21-Dd1e100">
          <head xml:id="gom-Isam21-Hd1e102">Versus 1</head>
          <p xml:id="gom-Isam21-d1e104">
            <pb ed="#P" n="0559C"/>
            <quote xml:id="gom-Isam21-Qd1e108" type="lemma" source="http://scta.info/resource/Isam21_1@7-7">Achimelech.</quote>
            <ref xml:id="gom-Isam21-Rd1e111"><name xml:id="gom-Isam21-Nd1e112" ref="#RabanusMaurus">RAB.</name></ref>
            <quote xml:id="gom-Isam21-Qd1e115"><seg type="qs">Id est, <quote xml:id="gom-Isam21-Qd1e118">frater meus rex,</quote></seg> etc., usque ad <seg type="qs">apostoli a contagione Judaeorum fide sanctificati sunt.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-Isam21-Dd1e125">
          <head xml:id="gom-Isam21-Hd1e127">Versus 5</head>
          <p xml:id="gom-Isam21-d1e129">
            <quote xml:id="gom-Isam21-Qd1e131" type="lemma" source="http://scta.info/resource/Isam21_5@28-28">Via.</quote>
            <ref xml:id="gom-Isam21-Rd1e134"><name xml:id="gom-Isam21-Nd1e135" ref="#RabanusMaurus">ID.</name></ref>
            <quote xml:id="gom-Isam21-Qd1e138"><seg type="qs">In Hebraeo</seg>, etc., usque ad <seg type="qs">et periculo vitae urgente non vesceretur eis.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-Isam21-Dd1e147">
          <head xml:id="gom-Isam21-Hd1e149">Versus 6</head>
          <p xml:id="gom-Isam21-d1e151">
            <quote xml:id="gom-Isam21-Qd1e153" type="lemma" source="http://scta.info/resource/Isam21_6@1-2">Dedit ergo.</quote>
            <ref xml:id="gom-Isam21-Rd1e156"><name xml:id="gom-Isam21-Nd1e157" ref="#RabanusMaurus">ID.</name></ref>
            <quote xml:id="gom-Isam21-Qd1e160"><seg type="qs">Quantum ad prophetiam pertinet</seg>, etc., usque ad <seg type="qs">unde: <quote xml:id="gom-Isam21-Qd1e166" source="http://scta.info/resource/io15_20@14-20">Si me persecuti sunt, et vos persequentur</quote>.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-Isam21-Dd1e172">
          <head xml:id="gom-Isam21-Hd1e174">Versus 7</head>
          <p xml:id="gom-Isam21-d1e176">
            <quote xml:id="gom-Isam21-Qd1e178" type="lemma" source="http://scta.info/resource/Isam21_7@12-14">In tabernaculo Domini.</quote>
            <ref xml:id="gom-Isam21-Rd1e181"><name xml:id="gom-Isam21-Nd1e182" ref="#RabanusMaurus">RAB.</name></ref>
            <quote xml:id="gom-Isam21-Qd1e185">In Heb.</quote>
          </p>
          <p xml:id="gom-Isam21-d1e188">
            <quote xml:id="gom-Isam21-Qd1e190" type="lemma" source="http://scta.info/resource/Isam21_7">obligatus in conspectu Domini,</quote>
            <!-- check: lemma not matched to verse text -->
            forte enim voverat, quia aliquot diebus in tabernaculo Domini moraretur et vacaret orationibus.
          </p>
          <p xml:id="gom-Isam21-d1e196">
            <quote xml:id="gom-Isam21-Qd1e198" type="lemma" source="http://scta.info/resource/Isam21_7">Doeg Idumaeus.</quote>
            <!-- check: lemma not matched to verse text -->
            <ref xml:id="gom-Isam21-Rd1e203"><name xml:id="gom-Isam21-Nd1e204" ref="#RabanusMaurus">ID.</name></ref>
            <quote xml:id="gom-Isam21-Qd1e207"><seg type="qs">Qui camelorum, id est, <pb ed="#P" n="0559D"/> infructuosi gregis et tortuosi custos erat</seg>, etc., usque ad <seg type="qs">quia nemo potest nocere Christo sacerdotum principi, <quote xml:id="gom-Isam21-Qd1e215">qui victor coelos ascendit.</quote></seg></quote>
          </p>
          <p xml:id="gom-Isam21-d1e218">
            <ref xml:id="gom-Isam21-Rd1e220" type="lemma" subtype="implied" target="http://scta.info/resource/Isam21_7"/>
            <ref xml:id="gom-Isam21-Rd1e222"><name xml:id="gom-Isam21-Nd1e223" ref="#RabanusMaurus">RAB.</name> ex Isid.</ref>
            <quote xml:id="gom-Isam21-Qd1e227"><seg type="qs">Achis interpretatur</seg>, etc., usque ad <seg type="qs">intus divina virtus, tanquam barba latebat.</seg></quote>
          </p>
        </div>
      </div>
    </body>
