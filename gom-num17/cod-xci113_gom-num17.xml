    <body>
      <div xml:id="gom-num17">
        <head xml:id="gom-num17-Hd1e98">Caput 17</head>
        <div xml:id="gom-num17-Dd1e100">
          <head xml:id="gom-num17-Hd1e102">Versus 2</head>
          <p xml:id="gom-num17-d1e104">
            <quote xml:id="gom-num17-Qd1e106" type="lemma" source="http://scta.info/resource/num17_2@14-16">A cunctis principibus.</quote>
            Omnis princeps habet virgam, quia sine ea populum regere non potest. Unde Paulus, quia princeps populi erat, dicebat. <quote xml:id="gom-num17-Qd1e109" source="http://scta.info/resource/Icor4_21@1-10">Quid vultis, in virga veniam ad vos, an in charitate?</quote>
          </p>
          <p xml:id="gom-num17-d1e113">
            <pb ed="#P" n="0406B"/>
            <ref xml:id="gom-num17-Rd1e117" type="lemma" subtype="implied" target="http://scta.info/resource/num17_2@14-16"/>
            <ref xml:id="gom-num17-Rd1e119"><name xml:id="gom-num17-Nd1e120" ref="#Origen">ORIG.</name></ref>
            <quote xml:id="gom-num17-Qd1e123"><seg type="qs">Omnes principes tribuum necesse est ut habeant virgas</seg>, etc., usque ad <seg type="qs">et cum nucibus sacerdotalium pomorum copiam invenisse.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-num17-Dd1e132">
          <head xml:id="gom-num17-Hd1e134">Versus 5</head>
          <p xml:id="gom-num17-d1e136">
            <quote xml:id="gom-num17-Qd1e138" type="lemma" source="http://scta.info/resource/num17_5@5-6">Germinabit virga.</quote>
            <ref xml:id="gom-num17-Rd1e141"><name xml:id="gom-num17-Nd1e142" ref="#Origen">ORIG.</name>, ubi supra.</ref>
            <quote xml:id="gom-num17-Qd1e146"><seg type="qs">Unum fructum promisit Deus in virga et dedit plura</seg>, etc., usque ad <seg type="qs">sed quae in sola sapientia continentur.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-num17-Dd1e155">
          <head xml:id="gom-num17-Hd1e157">Versus 8</head>
          <p xml:id="gom-num17-d1e159">
            <quote xml:id="gom-num17-Qd1e161" type="lemma" source="http://scta.info/resource/num17_8@4-6">Invenit germinasse virgam,</quote>
            etc.
            <ref xml:id="gom-num17-Rd1e164"><name xml:id="gom-num17-Nd1e165" ref="#Origen">ORIG.</name>, ubi supra.</ref>
            <quote xml:id="gom-num17-Qd1e169"><seg type="qs">Cum sacerdotium Aaron</seg>, etc., usque ad, <seg type="qs">sed nostra adhuc corpora usque in finem mundi differunt a gloria resurrectionis.</seg></quote>
          </p>
          <p xml:id="gom-num17-d1e177">
            <ref xml:id="gom-num17-Rd1e179" type="lemma" subtype="implied" target="http://scta.info/resource/num17_8@4-6"/>
            <ref xml:id="gom-num17-Rd1e181"><name xml:id="gom-num17-Nd1e182" ref="#Origen">ID.</name></ref>
            <quote xml:id="gom-num17-Qd1e185"><seg type="qs">Virga arida germinat</seg>, etc., usque ad <seg type="qs">corporis in resurrectione germinabit.</seg></quote>
          </p>
          <p xml:id="gom-num17-d1e193">
            <quote xml:id="gom-num17-Qd1e195" type="lemma" source="http://scta.info/resource/num17_8@6-6">Virgam,</quote>
            <ref xml:id="gom-num17-Rd1e198"><name xml:id="gom-num17-Nd1e199" ref="#GregoryGreat">GREG.</name>, lib. IV Moral., cap. 29.</ref>
            <quote xml:id="gom-num17-Qd1e203"><seg type="qs">Carnem Christi, quae de radice Jesse succisa et mortificata</seg>, etc., usque ad <seg type="qs">corona martyrum, gratia continentium.</seg></quote>
          </p>
          <p xml:id="gom-num17-d1e211">
            <pb ed="#P" n="0406C"/>
            <quote xml:id="gom-num17-Qd1e215" type="lemma" source="http://scta.info/resource/num17_8@12-12">Turgentibus,</quote>
            etc.
            <ref xml:id="gom-num17-Rd1e218"><name xml:id="gom-num17-Nd1e219" ref="#Origen">ORIG.</name></ref>
            <quote xml:id="gom-num17-Qd1e222"><seg type="qs">Hac vero ratione</seg>, etc., usque ad <seg type="qs">sed secundum Scripturam in mille generationes.</seg></quote>
          </p>
          <p xml:id="gom-num17-d1e231">
            <ref xml:id="gom-num17-Rd1e233" type="lemma" subtype="implied" target="http://scta.info/resource/num17_8@12-12"/>
            <ref xml:id="gom-num17-Rd1e235"><name xml:id="gom-num17-Nd1e236" ref="#Origen">ORIG.</name>, ubi supra.</ref>
            <quote xml:id="gom-num17-Qd1e240"><seg type="qs">Possumus etiam sic intelligere eorum</seg>, etc., usque ad <seg type="qs">qui sunt charitas, gaudium, pax et caeterae virtutes <!--<note>(Gal. V)</note>-->.</seg></quote>
          </p>
        </div>
      </div>
    </body>
