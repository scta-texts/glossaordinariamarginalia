    <body>
      <div xml:id="gom-ios24">
        <head xml:id="gom-ios24-Hd1e98">Caput 24</head>
        <div xml:id="gom-ios24-Dd1e100">
          <head xml:id="gom-ios24-Hd1e102">Versus 3</head>
          <p xml:id="gom-ios24-d1e104">
            <quote xml:id="gom-ios24-Qd1e106" type="lemma" source="http://scta.info/resource/ios24_3@1-4">Tuli ergo patrem vestrum.</quote>
            <ref xml:id="gom-ios24-Rd1e109"><name xml:id="gom-ios24-Nd1e110" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ios24-Qd1e113"><seg type="qs">Quod LXX habent</seg>, etc., usque ad <seg type="qs">quod est verum semen Abrahae.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios24-Dd1e122">
          <head xml:id="gom-ios24-Hd1e124">Versus 11</head>
          <p xml:id="gom-ios24-d1e126">
            <quote xml:id="gom-ios24-Qd1e128" type="lemma" source="http://scta.info/resource/ios24_11@7-7">Pugnaverunt.</quote>
            <ref xml:id="gom-ios24-Rd1e131"><name xml:id="gom-ios24-Nd1e132" ref="#Augustine">AUG.</name>, quaest. 26 in Jos.</ref>
            <quote xml:id="gom-ios24-Qd1e136"><seg type="qs">Clausis portis se murorum ambitu tuebantur</seg>, etc., usque ad <seg type="qs">armata defensio.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios24-Dd1e145">
          <head xml:id="gom-ios24-Hd1e147">Versus 12</head>
          <p xml:id="gom-ios24-d1e149">
            <quote xml:id="gom-ios24-Qd1e151" type="lemma" source="http://scta.info/resource/ios24_12@4-4">Crabrones.</quote>
            <ref xml:id="gom-ios24-Rd1e154"><name xml:id="gom-ios24-Nd1e155" ref="#Augustine">AUG.</name>, quaest 27.</ref>
            <quote xml:id="gom-ios24-Qd1e159">LXX: <mentioned>Vespas</mentioned>. Id est forte translative acerrimos timoris aculeos, quibus quodammodo timoribus pungebantur fugerent, aut aereos occultos spiritus, quod in Psalmis dicitur, <quote xml:id="gom-ios24-Qd1e163" source="http://scta.info/resource/ps77_49@13-15">per angelos malos,</quote> nisi quis dicat, non omnia quae facta sunt esse scripta, et velit veras <pb ed="#P" n="0520D"/> vespas intelligi.</quote>
          </p>
        </div>
        <div xml:id="gom-ios24-Dd1e171">
          <head xml:id="gom-ios24-Hd1e173">Versus 19</head>
          <p xml:id="gom-ios24-d1e175">
            <quote xml:id="gom-ios24-Qd1e177" type="lemma" source="http://scta.info/resource/ios24_19@5-6">Non poteritis.</quote>
            <ref xml:id="gom-ios24-Rd1e180"><name xml:id="gom-ios24-Nd1e181" ref="#Augustine">AUG.</name>, quaest. 28 in Jos.</ref>
            <quote xml:id="gom-ios24-Qd1e185"><seg type="qs">Non poteritis servire Domino</seg>, etc., usque ad <seg type="qs">et postea superabundaret gratia per Jesum Christum, qui est finis legis.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios24-Dd1e195">
          <head xml:id="gom-ios24-Hd1e197">Versus 23</head>
          <p xml:id="gom-ios24-d1e199">
            <quote xml:id="gom-ios24-Qd1e201" type="lemma" source="http://scta.info/resource/ios24_23@4-4">Auferte.</quote>
            <ref xml:id="gom-ios24-Rd1e204"><name xml:id="gom-ios24-Nd1e205" ref="#Augustine">AUG.</name>, quaest. 29 in Jos.</ref>
            <quote xml:id="gom-ios24-Qd1e209"><seg type="qs">Quid est quod ait</seg>, etc., usque ad: <seg type="qs"><quote xml:id="gom-ios24-Qd1e214" source="http://scta.info/resource/Icor13_12@9-13">facie ad faciem cognoscamus eum</quote>.</seg></quote>
          </p>
          <p xml:id="gom-ios24-d1e219">
            <quote xml:id="gom-ios24-Qd1e221" type="lemma" source="http://scta.info/resource/ios24_23">Et disposuit Jesus testamentum,</quote>
            <!-- check: lemma not matched to verse text -->
            <ref xml:id="gom-ios24-Rd1e226"><name xml:id="gom-ios24-Nd1e227" ref="#Augustine">AUG.</name>, quaest. 30 in Jos.</ref>
            <quote xml:id="gom-ios24-Qd1e231"><seg type="qs">etc. Haec verba qui altius perscrutantur</seg>, etc., usque ad: <seg type="qs"><quote xml:id="gom-ios24-Qd1e236" source="http://scta.info/resource/IItim4_16@8-13">sed omnes me dereliquerunt, quod non illis imputetur</quote>.</seg></quote>
          </p>
        </div>
      </div>
    </body>
