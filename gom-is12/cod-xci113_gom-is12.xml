    <body>
      <div xml:id="gom-is12">
        <head xml:id="gom-is12-Hd1e98">Caput 12</head>
        <div xml:id="gom-is12-Dd1e100">
          <head xml:id="gom-is12-Hd1e102">Versus 1</head>
          <p xml:id="gom-is12-d1e104">
            <quote xml:id="gom-is12-Qd1e106" type="lemma" source="http://scta.info/resource/is12_1@6-7">Confitebor tibi.</quote>
            <ref xml:id="gom-is12-Rd1e109"><name xml:id="gom-is12-Nd1e110" ref="#Jerome">HIER.</name></ref>
            <quote xml:id="gom-is12-Qd1e113">Sicut transito <pb ed="#P" n="1252A"/> mari Rubro, dixerunt: Cantemus Domino, etc. Sic regno mundi destructo, dicit Ecclesia: <quote xml:id="gom-is12-Qd1e117" source="http://scta.info/resource/is12_1@6-7">Confitebor tibi.</quote></quote>
          </p>
        </div>
        <div xml:id="gom-is12-Dd1e122">
          <head xml:id="gom-is12-Hd1e124">Versus 3</head>
          <p xml:id="gom-is12-d1e126">
            <quote xml:id="gom-is12-Qd1e128" type="lemma" source="http://scta.info/resource/is12_3@5-7">De fontibus Salvatoris.</quote>
            <ref xml:id="gom-is12-Rd1e131"><name xml:id="gom-is12-Nd1e132" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-is12-Qd1e135"><seg type="qs">Unde: <quote xml:id="gom-is12-Qd1e138" source="http://scta.info/resource/ps67_27@3-8">Benedicite Domino de fontibus Israel,</quote></seg> etc., usque ad <seg type="qs">ut prophetia cum Evangelio conveniat.</seg></quote>
          </p>
        </div>
      </div>
    </body>
