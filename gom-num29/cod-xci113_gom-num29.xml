    <body>
      <div xml:id="gom-num29">
        <head xml:id="gom-num29-Hd1e98">Caput 29</head>
        <div xml:id="gom-num29-Dd1e100">
          <head xml:id="gom-num29-Hd1e102">Versus 1</head>
          <p xml:id="gom-num29-d1e104">
            <quote xml:id="gom-num29-Qd1e106" type="lemma" source="http://scta.info/resource/num29_1@1-3">Mensis etiam septimi.</quote>
            <ref xml:id="gom-num29-Rd1e109"><name xml:id="gom-num29-Nd1e110" ref="#Origen">ORIG.</name>, hom. 23 in Num.</ref>
            <quote xml:id="gom-num29-Qd1e114"><seg type="qs">Sequitur festivitas septimorum</seg>, etc., usque ad <seg type="qs">quem posuit Deus propitiatorem in sanguine suo, per fidem.</seg></quote>
          </p>
          <p xml:id="gom-num29-d1e122">
            <ref xml:id="gom-num29-Rd1e124" type="lemma" subtype="implied" target="http://scta.info/resource/num29_1@1-3"/>
            <ref xml:id="gom-num29-Rd1e126"><name xml:id="gom-num29-Nd1e127" ref="#Origen">ORIG.</name></ref>
            <quote xml:id="gom-num29-Qd1e130">Ultimus dies festus, etc., <quote xml:id="gom-num29-Qd1e132" source="http://scta.info/resource/Icor13_10@1-11">usque ad, Cum autem venerit quod perfectum est, evacuabitur quod ex parte est</quote>.</quote>
          </p>
        </div>
      </div>
    </body>
