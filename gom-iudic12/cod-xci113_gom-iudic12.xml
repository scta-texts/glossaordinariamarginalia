      <div xml:id="gom-iudic12">
        <head xml:id="gom-iudic12-Hd1e98">Caput 12</head>
        <div xml:id="gom-iudic12-Dd1e100">
          <head xml:id="gom-iudic12-Hd1e102">Versus 7</head>
          <p xml:id="gom-iudic12-d1e104">
            <quote xml:id="gom-iudic12-Qd1e106" type="lemma" source="http://scta.info/resource/iudic12_7@1-2">Judicavit itaque Jephte,</quote>
            etc.
            <ref xml:id="gom-iudic12-Rd1e109"><name xml:id="gom-iudic12-Nd1e110" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-iudic12-Qd1e113">Sicut illi duo menses propter septuaginta dies senarium numerum sex aetatum significant, ita hic <pb ed="#P" n="0531A"/> sexies septenarius ductus hoc idem figurat, quantum ad sex saeculi aetates pertinet; sexies enim septem quadraginta duo sunt, nec frustra ipse Jephte sex annis populum judicavit.</quote>
          </p>
        </div>
      </div>
