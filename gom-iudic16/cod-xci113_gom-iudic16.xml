    <body>
      <div xml:id="gom-iudic16">
        <head xml:id="gom-iudic16-Hd1e98">Caput 16</head>
        <div xml:id="gom-iudic16-Dd1e100">
          <head xml:id="gom-iudic16-Hd1e102">Versus 1</head>
          <p xml:id="gom-iudic16-d1e104">
            <pb ed="#P" n="0532B"/>
            <quote xml:id="gom-iudic16-Qd1e108" type="lemma" source="http://scta.info/resource/iudic16_1@1-2">Abiit quoque,</quote>
            etc.
            <ref xml:id="gom-iudic16-Rd1e111"><name xml:id="gom-iudic16-Nd1e112" ref="#GregoryGreat">GREG.</name>, Homil. 21 in Evang.</ref>
            <quote xml:id="gom-iudic16-Qd1e116"><seg type="qs">Quem in hoc facto Samson</seg>, etc., usque ad <seg type="qs">et ascendendo regna coelorum penetravit.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-iudic16-Dd1e125">
          <head xml:id="gom-iudic16-Hd1e127">Versus 19</head>
          <p xml:id="gom-iudic16-d1e129">
            <quote xml:id="gom-iudic16-Qd1e131" type="lemma" source="http://scta.info/resource/iudic16_19@15-16">Vocavitque tonsorem.</quote>
            <ref xml:id="gom-iudic16-Rd1e134"><name xml:id="gom-iudic16-Nd1e135" ref="#IsidoreOfSeville">ISID.</name>, in Jud., tom. V, cap. 6.</ref>
            <quote xml:id="gom-iudic16-Qd1e139"><seg type="qs">Quod mulier subdola caput Samsonis rasit</seg>, etc., usque ad <seg type="qs">et parato certamine in finem fortissime daemones triumphabit.</seg></quote>
          </p>
          <p xml:id="gom-iudic16-d1e147">
            <ref xml:id="gom-iudic16-Rd1e149" type="lemma" subtype="implied" target="http://scta.info/resource/iudic16_19@15-16"/>
            <ref xml:id="gom-iudic16-Rd1e151"><name xml:id="gom-iudic16-Nd1e152" ref="#GregoryGreat">GREG.</name>, lib. XXVII Moral., cap. 13.</ref>
            <quote xml:id="gom-iudic16-Qd1e156"><seg type="qs">Samson amissis oculis ab Allophylis ad molam deputatur</seg>, etc., usque ad <seg type="qs">foris in circuitum laboris mittunt.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-iudic16-Dd1e165">
          <head xml:id="gom-iudic16-Hd1e167">Versus 30</head>
          <p xml:id="gom-iudic16-d1e169">
            <quote xml:id="gom-iudic16-Qd1e171" type="lemma" source="http://scta.info/resource/iudic16_30@21-21">Multoque.</quote>
            <ref xml:id="gom-iudic16-Rd1e174"><name xml:id="gom-iudic16-Nd1e175" ref="#GregoryGreat">GREG.</name>, lib. XXIX Moral., cap. 7.</ref>
            <quote xml:id="gom-iudic16-Qd1e179"><seg type="qs">In hoc loco per Samson Christus significatur</seg>, etc., usque ad <seg type="qs">simul omnes moriendo prostravit.</seg></quote>
          </p>
        </div>
      </div>
    </body>
