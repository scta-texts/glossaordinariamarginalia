    <body>
      <div xml:id="gom-ios17">
        <head xml:id="gom-ios17-Hd1e98">Caput 17</head>
        <div xml:id="gom-ios17-Dd1e100">
          <head xml:id="gom-ios17-Hd1e102">Versus 12</head>
          <p xml:id="gom-ios17-d1e104">
            <quote xml:id="gom-ios17-Qd1e106" type="lemma" source="http://scta.info/resource/ios17_12@1-2">Nec potuerunt.</quote>
            <ref xml:id="gom-ios17-Rd1e109"><name xml:id="gom-ios17-Nd1e110" ref="#Origen">ADAM.</name>, hom. 22 in Jos.</ref>
            <quote xml:id="gom-ios17-Qd1e114"><seg type="qs">Chananaei tertio dicuntur esse in filiis Ephrem, <pb ed="#P" n="0519A"/></seg> etc., usque ad <seg type="qs">exterminari a nobis dicitur Chananaeus.</seg></quote>
          </p>
          <p xml:id="gom-ios17-d1e123">
            <ref xml:id="gom-ios17-Rd1e125" type="lemma" subtype="implied" target="http://scta.info/resource/ios17_12@1-2"/>
            <ref xml:id="gom-ios17-Rd1e127"><name xml:id="gom-ios17-Nd1e128" ref="#Origen">ADAM.</name>, nom. 22.</ref>
            <quote xml:id="gom-ios17-Qd1e132"><seg type="qs">Illud quoque praetereundum est</seg>, etc., usque ad <seg type="qs">in dotem transcribit.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios17-Dd1e141">
          <head xml:id="gom-ios17-Hd1e143">Versus 14</head>
          <p xml:id="gom-ios17-d1e145">
            <quote xml:id="gom-ios17-Qd1e147" type="lemma" source="http://scta.info/resource/ios17_14@1-2">Locutique sunt.</quote>
            <ref xml:id="gom-ios17-Rd1e150"><name xml:id="gom-ios17-Nd1e151" ref="#Origen">ORIG.</name>, hom. 22.</ref>
            <quote xml:id="gom-ios17-Qd1e155"><seg type="qs">Post haec videndum est</seg>, etc., usque ad <seg type="qs">ut naturalis vigor ingenitae virtutis effulgeat.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios17-Dd1e164">
          <head xml:id="gom-ios17-Hd1e166">Versus 16</head>
          <p xml:id="gom-ios17-d1e168">
            <quote xml:id="gom-ios17-Qd1e170" type="lemma" source="http://scta.info/resource/ios17_16@5-8">Non poterimus ad montana.</quote>
            <ref xml:id="gom-ios17-Rd1e173"><name xml:id="gom-ios17-Nd1e174" ref="#Origen">ADAM.</name>, ibid.</ref>
            <quote xml:id="gom-ios17-Qd1e178"><seg type="qs">Non sufficit nobis mons</seg>, etc., usque ad <seg type="qs">de Israelitis faciant Chananaeos.</seg></quote>
          </p>
        </div>
      </div>
    </body>
