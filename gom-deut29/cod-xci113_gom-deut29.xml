    <body>
      <div xml:id="gom-deut29">
        <head xml:id="gom-deut29-Hd1e98">Caput 29</head>
        <div xml:id="gom-deut29-Dd1e100">
          <head xml:id="gom-deut29-Hd1e102">Versus 1</head>
          <p xml:id="gom-deut29-d1e104">
            <quote xml:id="gom-deut29-Qd1e106" type="lemma" source="http://scta.info/resource/deut29_1@1-3">Haec sunt verba,</quote>
            etc.
            <ref xml:id="gom-deut29-Rd1e109"><name xml:id="gom-deut29-Nd1e110" ref="#Augustine">AUG.</name>, quaest. 49 in Deut.</ref>
            <quote xml:id="gom-deut29-Qd1e114"><seg type="qs">LXX: <quote xml:id="gom-deut29-Qd1e117" source="http://scta.info/resource/deut29_1@1-3">Haec sunt verba testamenti,</quote></seg> etc., usque ad <seg type="qs">ad Abraham de circumcisione vel ad Noe.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-deut29-Dd1e125">
          <head xml:id="gom-deut29-Hd1e127">Versus 3</head>
          <p xml:id="gom-deut29-d1e129">
            <pb ed="#P" n="0486D"/>
            <quote xml:id="gom-deut29-Qd1e133" type="lemma" source="http://scta.info/resource/deut29_3@1-2">Tentationes magnas,</quote>
            etc.
          </p>
        </div>
        <div xml:id="gom-deut29-Dd1e138">
          <head xml:id="gom-deut29-Hd1e140">Versus 4</head>
          <p xml:id="gom-deut29-d1e142">
            <quote xml:id="gom-deut29-Qd1e144" type="lemma" source="http://scta.info/resource/deut29_4@1-6">Et non dedit Dominus Deus vobis cor scire,</quote>
            <ref xml:id="gom-deut29-Rd1e147"><name xml:id="gom-deut29-Nd1e148" ref="#Augustine">AUG.</name>, quaest. 50.</ref>
            <quote xml:id="gom-deut29-Qd1e152">etc., usque ad <seg type="qs">quoniam judicia Dei quamvis occulta, tamen justa sunt.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-deut29-Dd1e159">
          <head xml:id="gom-deut29-Hd1e161">Versus 6</head>
          <p xml:id="gom-deut29-d1e163">
            <quote xml:id="gom-deut29-Qd1e165" type="lemma" source="http://scta.info/resource/deut29_6@1-3">Panem non comedistis,</quote>
            etc.
            <ref xml:id="gom-deut29-Rd1e168"><name xml:id="gom-deut29-Nd1e169" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-deut29-Qd1e172"><seg type="qs">Hinc apparet Israelitas</seg>, etc., usque ad <seg type="qs">principium belli, sed principium vini.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-deut29-Dd1e182">
          <head xml:id="gom-deut29-Hd1e184">Versus 18</head>
          <p xml:id="gom-deut29-d1e186">
            <quote xml:id="gom-deut29-Qd1e188" type="lemma" source="http://scta.info/resource/deut29_18@1-3">Ne forte sit.</quote>
            <ref xml:id="gom-deut29-Rd1e191"><name xml:id="gom-deut29-Nd1e192" ref="#Augustine">AUG.</name>, quaest. 52.</ref>
            <quote xml:id="gom-deut29-Qd1e196"><seg type="qs">LXX: <quote xml:id="gom-deut29-Qd1e199" source="http://scta.info/resource/deut29_18@28-31">Nunquid aliquis est inter vos,</quote></seg> etc., usque ad <seg type="qs">non conjugem sibi concupiverat alienam.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-deut29-Dd1e207">
          <head xml:id="gom-deut29-Hd1e209">Versus 19</head>
          <p xml:id="gom-deut29-d1e211">
            <quote xml:id="gom-deut29-Qd1e213" type="lemma" source="http://scta.info/resource/deut29_19">Ebria sitientem, et Dominus,</quote>
            <!-- check: lemma not matched to verse text -->
            etc. Id est, ne quis plenus malitia et idololatria seducat eum qui sitit discere et scire veritatem, sicuti faciunt haeretici.
          </p>
        </div>
      </div>
    </body>
