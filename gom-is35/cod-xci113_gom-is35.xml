    <body>
      <div xml:id="gom-is35">
        <head xml:id="gom-is35-Hd1e98">Caput 35</head>
        <div xml:id="gom-is35-Dd1e100">
          <head xml:id="gom-is35-Hd1e102">Versus 1</head>
          <p xml:id="gom-is35-d1e104">
            <pb ed="#P" n="1277C"/>
            <quote xml:id="gom-is35-Qd1e108" type="lemma" source="http://scta.info/resource/is35_1@1-1">Laetabitur.</quote>
            Exposita captivitate Judaeorum, agit de conversione gentium.
          </p>
        </div>
        <div xml:id="gom-is35-Dd1e113">
          <head xml:id="gom-is35-Hd1e115">Versus 2</head>
          <p xml:id="gom-is35-d1e117">
            <quote xml:id="gom-is35-Qd1e119" type="lemma" source="http://scta.info/resource/is35_2@16-16">Saron.</quote>
            Populi Judaeorum; unde: <quote xml:id="gom-is35-Qd1e122" source="http://scta.info/resource/is32_2@2-4">Erit Saron sicut desertum</quote>.
          </p>
        </div>
        <div xml:id="gom-is35-Dd1e127">
          <head xml:id="gom-is35-Hd1e129">Versus 7</head>
          <p xml:id="gom-is35-d1e131">
            <quote xml:id="gom-is35-Qd1e133" type="lemma" source="http://scta.info/resource/is35_7@20-21">Viror calami.</quote>
            Impletio Scripturae, quae per calamum; et intentionis adjutorium, quae per juncum: calamus enim et juncus juxta aquas oriuntur et virent.
          </p>
        </div>
      </div>
