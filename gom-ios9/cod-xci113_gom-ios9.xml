    <body>
      <div xml:id="gom-ios9">
        <head xml:id="gom-ios9-Hd1e98">Caput 9</head>
        <div xml:id="gom-ios9-Dd1e100">
          <head xml:id="gom-ios9-Hd1e102">Versus 2</head>
          <p xml:id="gom-ios9-d1e104">
            <pb ed="#P" n="0512D"/>
            <quote xml:id="gom-ios9-Qd1e108" type="lemma" source="http://scta.info/resource/ios9_2@1-1">Congregati,</quote>
            etc.
            <ref xml:id="gom-ios9-Rd1e111"><name xml:id="gom-ios9-Nd1e112" ref="#Origen">ADAM.</name>, hom. 9 in Jos.</ref>
            <quote xml:id="gom-ios9-Qd1e116"><seg type="qs">Ex his quae gesta sunt</seg>, etc., usque ad <seg type="qs">conteretur Satanas sub pedibus servorum ejus <!--<note>(Rom. XVI)</note>-->.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios9-Dd1e127">
          <head xml:id="gom-ios9-Hd1e129">Versus 3</head>
          <p xml:id="gom-ios9-d1e131">
            <quote xml:id="gom-ios9-Qd1e133" type="lemma" source="http://scta.info/resource/ios9_3@1-3">At hi qui,</quote>
            etc.
            <ref xml:id="gom-ios9-Rd1e136"><name xml:id="gom-ios9-Nd1e137" ref="#Origen">ID.</name>, hom. 10.</ref>
            <quote xml:id="gom-ios9-Qd1e141"><seg type="qs">In domo Patris mei mansiones multae sunt <!--<note>(Joan. XIV)</note>--></seg>, etc. usque ad <seg type="qs">libertatem pristinam revocantis verba non audias, fias peccati servus in aeternum.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios9-Dd1e151">
          <head xml:id="gom-ios9-Hd1e153">Versus 19</head>
          <p xml:id="gom-ios9-d1e155">
            <quote xml:id="gom-ios9-Qd1e157" type="lemma" source="http://scta.info/resource/ios9_19@4-4">Juravimus.</quote>
            <ref xml:id="gom-ios9-Rd1e160"><name xml:id="gom-ios9-Nd1e161" ref="#Augustine">AUG.</name>, quaest. 13 in Jos.</ref>
            <quote xml:id="gom-ios9-Qd1e165"><seg type="qs">Quaeritur quomodo jurationem hanc servandam crediderunt Hebraei Gabaonitis</seg>, etc., usque ad <seg type="qs">si quod ira perturbatus juraverat, non fecisset, quam si perfecisset.</seg></quote>
          </p>
          <p xml:id="gom-ios9-d1e173">
            <ref xml:id="gom-ios9-Rd1e175" type="lemma" subtype="implied" target="http://scta.info/resource/ios9_19@4-4"/>
            <ref xml:id="gom-ios9-Rd1e177"><name xml:id="gom-ios9-Nd1e178" ref="#IsidoreOfSeville">ISID.</name> in Jos.</ref>
            <quote xml:id="gom-ios9-Qd1e182">Gabaonitae significant eos qui credunt, et erga servos Dei devoti vel Ecclesiae cultum <pb ed="#P" n="0513A"/> videntur habere, nihil tamen emendationis vel devotionis vel innovationis habent in moribus, tales tantummodo quoddam signum salutis intra Ecclesiam temporaliter praeferunt. Inter spirituales autem, id est inter sanctos Dei, regnum aeternum vel libertatem non consequuntur.</quote>
          </p>
        </div>
      </div>
    </body>
