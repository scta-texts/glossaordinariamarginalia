    <body>
      <div xml:id="gom-ps53">
        <head xml:id="gom-ps53-Hd1e98">Psalmus 53</head>
        <div xml:id="gom-ps53-Dd1e100">
          <head xml:id="gom-ps53-Hd1e102">Versus 2</head>
          <p xml:id="gom-ps53-d1e104">
            <quote xml:id="gom-ps53-Qd1e106" type="lemma" source="http://scta.info/resource/ps53_2@3-3">Ziphaei.</quote>
            <ref xml:id="gom-ps53-Rd1e109"><name xml:id="gom-ps53-Nd1e110" ref="#Jerome">HIER.</name>, AUG.</ref>
            <quote xml:id="gom-ps53-Qd1e114"><seg type="qs">Florentes interpretantur</seg>, etc., usque ad <seg type="qs">monet in adversis Deum laudare.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ps53-Dd1e123">
          <head xml:id="gom-ps53-Hd1e125">Versus 3</head>
          <p xml:id="gom-ps53-d1e127">
            <quote xml:id="gom-ps53-Qd1e129" type="lemma" source="http://scta.info/resource/ps53_3@1-3">Deus, in nomine.</quote>
            <ref xml:id="gom-ps53-Rd1e132"><name xml:id="gom-ps53-Nd1e133" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ps53-Qd1e136">Inter Ziphaeos orat.</quote>
          </p>
          <p xml:id="gom-ps53-d1e139">
            <ref xml:id="gom-ps53-Rd1e141" type="lemma" subtype="implied" target="http://scta.info/resource/ps53_3@1-3"/>
            <ref xml:id="gom-ps53-Rd1e143"><name xml:id="gom-ps53-Nd1e144" ref="#Augustine">AUG.</name>, HIER.</ref>
            <quote xml:id="gom-ps53-Qd1e148">Hic salva in nomine, post non timeo judicari in virtute.</quote>
          </p>
          <p xml:id="gom-ps53-d1e151">
            <ref xml:id="gom-ps53-Rd1e153" type="lemma" subtype="implied" target="http://scta.info/resource/ps53_3@1-3"/>
            <ref xml:id="gom-ps53-Rd1e155"><name xml:id="gom-ps53-Nd1e156" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ps53-Qd1e159">Deus in nomine, verba Ecclesiae latentis inter Ziphaeos, cujus bonum intus est, et merces occulta, alii aliis petunt liberari: ego in tuo nomine.</quote>
          </p>
        </div>
        <div xml:id="gom-ps53-Dd1e163">
          <head xml:id="gom-ps53-Hd1e165">Versus 4</head>
          <p xml:id="gom-ps53-d1e167">
            <quote xml:id="gom-ps53-Qd1e169" type="lemma" source="http://scta.info/resource/ps53_4@1-2">Deus, exaudi.</quote>
            <ref xml:id="gom-ps53-Rd1e172"><name xml:id="gom-ps53-Nd1e173" ref="#Cassiodorus">CASS.</name></ref>
            <quote xml:id="gom-ps53-Qd1e176">Item Deus, nomen <pb ed="#P" n="0922B"/> potentiae, repetit ne tardet auxilium.</quote>
          </p>
          <p xml:id="gom-ps53-d1e182">
            <quote xml:id="gom-ps53-Qd1e184" type="lemma" source="http://scta.info/resource/ps53_4@7-7">Percipe,</quote>
            <ref xml:id="gom-ps53-Rd1e187"><name xml:id="gom-ps53-Nd1e188" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ps53-Qd1e191">Ziphaei ea etsi audiunt, non tamen intelligunt, qui non nisi temporalia noverunt.</quote>
          </p>
        </div>
        <div xml:id="gom-ps53-Dd1e195">
          <head xml:id="gom-ps53-Hd1e197">Versus 5</head>
          <p xml:id="gom-ps53-d1e199">
            <quote xml:id="gom-ps53-Qd1e201" type="lemma" source="http://scta.info/resource/ps53_5@2-2">Alieni.</quote>
            <ref xml:id="gom-ps53-Rd1e204"><name xml:id="gom-ps53-Nd1e205" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ps53-Qd1e208">Ziph viculus erat, qui pertinebat ad tribum Juda, unde Ziphaei.</quote>
          </p>
        </div>
        <div xml:id="gom-ps53-Dd1e213">
          <head xml:id="gom-ps53-Hd1e215">Versus 6</head>
          <p xml:id="gom-ps53-d1e217">
            <quote xml:id="gom-ps53-Qd1e219" type="lemma" source="http://scta.info/resource/ps53_6@1-2">Ecce enim.</quote>
            <ref xml:id="gom-ps53-Rd1e222"><name xml:id="gom-ps53-Nd1e223" ref="#Cassiodorus">CASS.</name></ref>
            <quote xml:id="gom-ps53-Qd1e226">Diapsalmus. Quid sibi et Ziphaeis faciat Deus unde solvit laudes.</quote>
          </p>
          <p xml:id="gom-ps53-d1e229">
            <quote xml:id="gom-ps53-Qd1e231" type="lemma" source="http://scta.info/resource/ps53_6@4-4">Adjuvat.</quote>
            <ref xml:id="gom-ps53-Rd1e234"><name xml:id="gom-ps53-Nd1e235" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ps53-Qd1e238">Quod ipsi nesciunt inter quos lateo; sed hoc quod me adjuvat viderent, si Deum ante oculos ponerent.</quote>
          </p>
        </div>
        <div xml:id="gom-ps53-Dd1e242">
          <head xml:id="gom-ps53-Hd1e244">Versus 7</head>
          <p xml:id="gom-ps53-d1e246">
            <quote xml:id="gom-ps53-Qd1e248" type="lemma" source="http://scta.info/resource/ps53_7@1-3">Averte mala inimicis.</quote>
            <ref xml:id="gom-ps53-Rd1e251"><name xml:id="gom-ps53-Nd1e252" ref="#Augustine">Ibid.</name></ref>
            <quote xml:id="gom-ps53-Qd1e255">Vel averte, pro convertendis praecatur: et haec est hostia quam pro liberatione solvit.</quote>
          </p>
          <p xml:id="gom-ps53-d1e258">
            <quote xml:id="gom-ps53-Qd1e260" type="lemma" source="http://scta.info/resource/ps53_7@7-8">In veritate.</quote>
            <ref xml:id="gom-ps53-Rd1e263"><name xml:id="gom-ps53-Nd1e264" ref="#Augustine">AUG.</name></ref>
            <quote xml:id="gom-ps53-Qd1e267">Vel secundum aliam litteram: <quote xml:id="gom-ps53-Qd1e269">In virtute,</quote> perde quos <pb ed="#P" n="0922C"/> in tua infirmitate tolerasti.</quote>
          </p>
        </div>
        <div xml:id="gom-ps53-Dd1e276">
          <head xml:id="gom-ps53-Hd1e278">Versus 8</head>
          <p xml:id="gom-ps53-d1e280">
            <quote xml:id="gom-ps53-Qd1e282" type="lemma" source="http://scta.info/resource/ps53_8@1-2">Voluntarie sacrificabo.</quote>
            <ref xml:id="gom-ps53-Rd1e285"><name xml:id="gom-ps53-Nd1e286" ref="#Augustine">Ibid.</name></ref>
            <quote xml:id="gom-ps53-Qd1e289">Quia propter se, non propter aliud, quod ab eo velim. Qui propter aliud laudat, ex necessitate laudat; si illud haberet, non laudaret.</quote>
          </p>
          <p xml:id="gom-ps53-d1e292">
            <quote xml:id="gom-ps53-Qd1e294" type="lemma" source="http://scta.info/resource/ps53_8">Mihi autem,</quote>
            <!-- check: lemma not matched to verse text -->
            et quae dedit propter dantem placent.
          </p>
        </div>
      </div>
    </body>
