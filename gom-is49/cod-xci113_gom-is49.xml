  <text xml:lang="la">
    <front>
      <div xml:id="starts-on">
        <pb ed="#P" n="1292A"/>
      </div>
    </front>
    <body>
      <div xml:id="gom-is49">
        <head xml:id="gom-is49-Hd1e98">Caput 49</head>
        <div xml:id="gom-is49-Dd1e100">
          <head xml:id="gom-is49-Hd1e102">Versus 1</head>
          <p xml:id="gom-is49-d1e104">
            <quote xml:id="gom-is49-Qd1e106" type="lemma" source="http://scta.info/resource/is49_1@1-2">Audite, insulae.</quote>
            <ref xml:id="gom-is49-Rd1e109"><name xml:id="gom-is49-Nd1e110" ref="#Jerome">HIER.</name></ref>
            <quote xml:id="gom-is49-Qd1e113">Post reliquiarum Israel vocationem et infidelium objectionem (de quibus, <quote xml:id="gom-is49-Qd1e115" source="http://scta.info/resource/is48_22@1-5">Non est pax impiis, dicit Dominus</quote> ), sub insularum <pb ed="#P" n="1292B"/> nomine alloquitur in persona Filii Ecclesias de gentibus.</quote>
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e123">
          <head xml:id="gom-is49-Hd1e125">Versus 2</head>
          <p xml:id="gom-is49-d1e127">
            <ref xml:id="gom-is49-Rd1e129" type="lemma" subtype="implied" target="http://scta.info/resource/is49_2"/>
            <quote xml:id="gom-is49-Qd1e131" source="http://scta.info/resource/mt10_34@9-14">Gladium acutum. Non veni pacem mittere, sed gladium</quote>, malos scilicet a bonis separans.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e136">
          <head xml:id="gom-is49-Hd1e138">Versus 3</head>
          <p xml:id="gom-is49-d1e140">
            <quote xml:id="gom-is49-Qd1e142" type="lemma" source="http://scta.info/resource/is49_3@12-12">Gloriabor.</quote>
            Quod non in aliis servis: <quote xml:id="gom-is49-Qd1e145" source="http://scta.info/resource/io17_6@2-3">Pater, glorificavi nomen tuum</quote> Et alibi: <quote xml:id="gom-is49-Qd1e148" source="http://scta.info/resource/ps56_9@1-3">Exsurge, gloria mea</quote>, etc.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e153">
          <head xml:id="gom-is49-Hd1e155">Versus 4</head>
          <p xml:id="gom-is49-d1e157">
            <quote xml:id="gom-is49-Qd1e159" type="lemma" source="http://scta.info/resource/is49_4@1-3">Et ego dixi.</quote>
            <ref xml:id="gom-is49-Rd1e162"><name xml:id="gom-is49-Nd1e163" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-is49-Qd1e166">Quasi dicat: Quomodo te glorificavi, qui magnam partem Judaeorum ad te revocare non potui? Hic autem liberum hominis monstratur arbitrium: Dei enim est vocare, nostrum credere, ipso tamen adjuvante, ut justi voluntatis praemium consequantur.</quote>
          </p>
          <p xml:id="gom-is49-d1e169">
            <quote xml:id="gom-is49-Qd1e171" type="lemma" source="http://scta.info/resource/is49_4@14-15">Ergo judicium,</quote>
            etc.
            <ref xml:id="gom-is49-Rd1e174"><name xml:id="gom-is49-Nd1e175" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-is49-Qd1e178">Judicabit Pater utrum <pb ed="#P" n="1292C"/> omnia fecerim eis quae debui: <quote xml:id="gom-is49-Qd1e182" source="http://scta.info/resource/io17_6@1-7">Manifestavi nomen tuum hominibus quos dedisti mihi.</quote> Et alibi: <quote xml:id="gom-is49-Qd1e185" source="http://scta.info/resource/io17_4@1-5">Ego te glorificavi super terram</quote>.</quote>
          </p>
          <p xml:id="gom-is49-d1e190">
            <quote xml:id="gom-is49-Qd1e192" type="lemma" source="http://scta.info/resource/is49_4@20-21">Opus meum.</quote>
            Alii: Labor et dolor meus: quia flevit civitatem, et ait in Psalmo: <quote xml:id="gom-is49-Qd1e195" source="http://scta.info/resource/ps29_10@1-5">Quae utilitas in sanguine meo?</quote> Juxta Hebraicum, pendens in cruce longe a salute mea verba lamentationum mearum.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e201">
          <head xml:id="gom-is49-Hd1e203">Versus 5</head>
          <p xml:id="gom-is49-d1e205">
            <quote xml:id="gom-is49-Qd1e207" type="lemma" source="http://scta.info/resource/is49_5@21-21">Glorificatus.</quote>
            Quasi dicat: Ego Judaeos perdidi, sed glorificatus sum in gentibus, unde, <quote xml:id="gom-is49-Qd1e210" source="http://scta.info/resource/mt28_18@8-17">Data est mihi omnis potestas in coelo et in terra.</quote>.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e215">
          <head xml:id="gom-is49-Hd1e217">Versus 7</head>
          <p xml:id="gom-is49-d1e219">
            <quote xml:id="gom-is49-Qd1e221" type="lemma" source="http://scta.info/resource/is49_7@12-12">Abominatam.</quote>
            Christum et Nazaraeos ejus, quos quotidie Judaei in synagogis maledicunt, quia propter eos regnum, locum et gentem amiserunt.
          </p>
          <p xml:id="gom-is49-d1e225">
            <quote xml:id="gom-is49-Qd1e227" type="lemma" source="http://scta.info/resource/is49_7@17-17">Reges.</quote>
            Propheta ad Filium.
          </p>
          <p xml:id="gom-is49-d1e231">
            <quote xml:id="gom-is49-Qd1e233" type="lemma" source="http://scta.info/resource/is49_7@17-18">Reges videbunt</quote>
            te venientem ad judicium: <quote xml:id="gom-is49-Qd1e236" source="http://scta.info/resource/is49_7@17-17">Reges,</quote> scilicet apostoli et alii <pb ed="#P" n="1292D"/> qui cum Domino judicabunt.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e243">
          <head xml:id="gom-is49-Hd1e245">Versus 8</head>
          <p xml:id="gom-is49-d1e247">
            <quote xml:id="gom-is49-Qd1e249" type="lemma" source="http://scta.info/resource/is49_8@4-6">In tempore placito.</quote>
            Passionis, resurrectionis, in quo placuit Deo redimere genus humanum.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e254">
          <head xml:id="gom-is49-Hd1e256">Versus 16</head>
          <p xml:id="gom-is49-d1e258">
            <quote xml:id="gom-is49-Qd1e260" type="lemma" source="http://scta.info/resource/is49_16@1-3">Ecce in manibus,</quote>
            etc.
            <ref xml:id="gom-is49-Rd1e263"><name xml:id="gom-is49-Nd1e264" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-is49-Qd1e267">Ex hoc discimus Jerusalem in regione Palestinae non esse quaerendam: quae totius provinciae deterrima et saxosis montibus exasperata penuriam fontium patitur.</quote>
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e271">
          <head xml:id="gom-is49-Hd1e273">Versus 17</head>
          <p xml:id="gom-is49-d1e275">
            <quote xml:id="gom-is49-Qd1e277" type="lemma" source="http://scta.info/resource/is49_17@2-2">Structores.</quote>
            Apostoli et alii: Culpa Judaeorum, id est, Scribarum et Pharisaeorum destructa es praedicatione quorumdam Judaeorum, id est apostolorum tam de Judaeis quam de gentibus congregata es.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e282">
          <head xml:id="gom-is49-Hd1e284">Versus 18</head>
          <p xml:id="gom-is49-d1e286">
            <quote xml:id="gom-is49-Qd1e288" type="lemma" source="http://scta.info/resource/is49_18@8-10">Omnes isti congregati.</quote>
            <quote xml:id="gom-is49-Qd1e291"><seg type="qs">Judaei ex omni natione</seg>, etc., usque ad <seg type="qs">quotidie congregantur ad fidem Ecclesiae.</seg></quote>
          </p>
          <p xml:id="gom-is49-d1e299">
            <pb ed="#P" n="1293A"/>
            <quote xml:id="gom-is49-Qd1e303" type="lemma" source="http://scta.info/resource/is49_18@22-22">Ornamento.</quote>
            Variis Spiritus sancti gratiis, quibus ornatur sponsae ambitio, de qua dicitur: <quote xml:id="gom-is49-Qd1e306" source="http://scta.info/resource/ps44_10@6-14">Astitit regina a dextris tuis in vestitu deaurato, circumdata varietate</quote>.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e312">
          <head xml:id="gom-is49-Hd1e314">Versus 21</head>
          <p xml:id="gom-is49-d1e316">
            <quote xml:id="gom-is49-Qd1e318" type="lemma" source="http://scta.info/resource/is49_21@10-11">Ego sterilis.</quote>
            Quia post Aggaeum, et Zachariam, et Malachiam, qui et Esdras, non habuerunt prophetas qui eos in lege nutrirent, usque ad Joannem Baptismam.
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e323">
          <head xml:id="gom-is49-Hd1e325">Versus 23</head>
          <p xml:id="gom-is49-d1e327">
            <quote xml:id="gom-is49-Qd1e329" type="lemma" source="http://scta.info/resource/is49_23@7-7">Reginae.</quote>
            Idem, sed magis affectuose. Unde: <quote xml:id="gom-is49-Qd1e332">Astitit regina,</quote> etc. Quae scilicet quotidie Christi parvulos nutrit et ad perfectam aetatem ducit.
          </p>
          <p xml:id="gom-is49-d1e335">
            <quote xml:id="gom-is49-Qd1e337" type="lemma" source="http://scta.info/resource/is49_23@14-14">Adorabunt.</quote>
            Venerabuntur secundum illud: <quote xml:id="gom-is49-Qd1e340" source="http://scta.info/resource/ps98_5@6-9">Adorabunt scabellum pedum ejus</quote>, in quo pede majestas indicatur.
          </p>
          <p xml:id="gom-is49-d1e344">
            <quote xml:id="gom-is49-Qd1e346" type="lemma" source="http://scta.info/resource/is49_23@17-19">Pulverem pedum tuorum.</quote>
            <ref xml:id="gom-is49-Rd1e349"><name xml:id="gom-is49-Nd1e350" ref="#Jerome">HIER.</name></ref>
            <quote xml:id="gom-is49-Qd1e353">Omnem scilicet <pb ed="#P" n="1293B"/> terrenitatem verbo et exemplo mundabunt, secundum quod dictum est, <quote xml:id="gom-is49-Qd1e357" source="http://scta.info/resource/mt16_19@17-22">Quodcunque solveris super terram, erit solutum</quote>, etc., unde: <quote xml:id="gom-is49-Qd1e360" source="http://scta.info/resource/mt10_14@17-21">Excutite pulverem pedum vestrorum</quote>.</quote>
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e366">
          <head xml:id="gom-is49-Hd1e368">Versus 25</head>
          <p xml:id="gom-is49-d1e370">
            <quote xml:id="gom-is49-Qd1e372" type="lemma" source="http://scta.info/resource/is49_25@1-4">Quia haec dicit Dominus.</quote>
            <ref xml:id="gom-is49-Rd1e375"><name xml:id="gom-is49-Nd1e376" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-is49-Qd1e379">Respondet quaestioni, quia haec scilicet in adventu suo compleantur.</quote>
          </p>
        </div>
        <div xml:id="gom-is49-Dd1e383">
          <head xml:id="gom-is49-Hd1e385">Versus 26</head>
          <p xml:id="gom-is49-d1e387">
            <quote xml:id="gom-is49-Qd1e389" type="lemma" source="http://scta.info/resource/is49_26@5-6">Carnibus suis.</quote>
            <quote xml:id="gom-is49-Qd1e392"><seg type="qs">Non aliena morte, sed propria</seg>, etc., usque ad <seg type="qs">ferocium bestiarum patens morsibus.</seg></quote>
          </p>
          <p xml:id="gom-is49-d1e400">
            <quote xml:id="gom-is49-Qd1e402" type="lemma" source="http://scta.info/resource/is49_26@25-26">Fortis Jacob.</quote>
            <quote xml:id="gom-is49-Qd1e405"><seg type="qs">Qui dedi fortitudinem Jacob luctandi</seg> etc., usque ad <seg type="qs">quasi et oratione contra Esau quem metuis, praevalebis.</seg></quote>
          </p>
        </div>
      </div>
    </body>
  </text>
