    <body>
      <div xml:id="gom-neh11">
        <head xml:id="gom-neh11-Hd1e98">Caput 11</head>
        <div xml:id="gom-neh11-Dd1e100">
          <head xml:id="gom-neh11-Hd1e102">Versus 1</head>
          <p xml:id="gom-neh11-d1e104">
            <quote xml:id="gom-neh11-Qd1e106" type="lemma" source="http://scta.info/resource/neh11_1@1-2">Habitaverunt autem.</quote>
            <ref xml:id="gom-neh11-Rd1e109"><name xml:id="gom-neh11-Nd1e110" ref="#Bede">BEDA</name>, in Esdr., lib. III, tom. II.</ref>
            <quote xml:id="gom-neh11-Qd1e114"><seg type="qs">Nunc completa est dispositio, etc., <pb ed="#P" n="0722D"/></seg> usque ad <seg type="qs">sed occulti judicis et largitoris munere percipiunt.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-neh11-Dd1e124">
          <head xml:id="gom-neh11-Hd1e126">Versus 4</head>
          <p xml:id="gom-neh11-d1e128">
            <quote xml:id="gom-neh11-Qd1e130" type="lemma" source="http://scta.info/resource/neh11_4@1-3">Et in Jerusalem.</quote>
            <ref xml:id="gom-neh11-Rd1e133"><name xml:id="gom-neh11-Nd1e134" ref="#Bede">ID.</name>, ibid.</ref>
            <quote xml:id="gom-neh11-Qd1e138"><seg type="qs">His verbis ostenditur</seg>, etc., usque ad <seg type="qs">nam sequitur: <quote xml:id="gom-neh11-Qd1e144" source="http://scta.info/resource/neh11_25@8-13">De filiis Juda habitaverunt in Cariatharbe</quote><!--<note>(II Esd. XI)</note>-->.</seg></quote>
          </p>
          <p xml:id="gom-neh11-d1e150">
            <ref xml:id="gom-neh11-Rd1e152" type="lemma" subtype="implied" target="http://scta.info/resource/neh11_4@1-3"/>
            <ref xml:id="gom-neh11-Rd1e154"><name xml:id="gom-neh11-Nd1e155" ref="#Bede">ID.</name>, ibid.</ref>
            <quote xml:id="gom-neh11-Qd1e159"><seg type="qs">Judas interpretatur <mentioned>confitens</mentioned> vel <mentioned>confessio</mentioned></seg>, etc., usque ad <seg type="qs">cum eorum qui sunt in agro unus assumetur, et alter relinquetur.</seg></quote>
          </p>
        </div>
      </div>
    </body>
