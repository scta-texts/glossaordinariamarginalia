  <text xml:lang="la">
    <front>
      <div xml:id="starts-on">
        <pb ed="#P" n="0034D"/>
      </div>
    </front>
    <body>
      <div xml:id="gom-ier18">
        <head xml:id="gom-ier18-Hd1e98">Caput 18</head>
        <div xml:id="gom-ier18-Dd1e100">
          <head xml:id="gom-ier18-Hd1e102">Versus 1</head>
          <p xml:id="gom-ier18-d1e104">
            <quote xml:id="gom-ier18-Qd1e106" type="lemma" source="http://scta.info/resource/ier18_1@1-9">Verbum quod factum est ad Jeremiam a Domino dicens.</quote>
            <ref xml:id="gom-ier18-Rd1e109"><name xml:id="gom-ier18-Nd1e110" ref="#Jerome">HIER.</name></ref>
            <quote xml:id="gom-ier18-Qd1e113"><seg type="qs">Per omnes sensus ad judicium</seg>, etc., usque ad <seg type="qs">et ibi audire praecepta Domini.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e122">
          <head xml:id="gom-ier18-Hd1e124">Versus 4</head>
          <p xml:id="gom-ier18-d1e126">
            <quote xml:id="gom-ier18-Qd1e128" type="lemma" source="http://scta.info/resource/ier18_4@1-3">Et dissipatum est,</quote>
            etc. Dissipatum divina providentia, ut nescius artifex errore suo parabolam figuraret.
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e133">
          <head xml:id="gom-ier18-Hd1e135">Versus 7</head>
          <p xml:id="gom-ier18-d1e137">
            <quote xml:id="gom-ier18-Qd1e139" type="lemma" source="http://scta.info/resource/ier18_7@1-2">Repente loquar.</quote>
            <ref xml:id="gom-ier18-Rd1e142"><name xml:id="gom-ier18-Nd1e143" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-ier18-Qd1e146"><seg type="qs">Liberum arbitrium <pb ed="#P" n="0035A"/> significat</seg>, etc., usque ad <seg type="qs">ut in omnibus excellat gratia largitoris.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e157">
          <head xml:id="gom-ier18-Hd1e159">Versus 11</head>
          <p xml:id="gom-ier18-d1e161">
            <quote xml:id="gom-ier18-Qd1e163" type="lemma" source="http://scta.info/resource/ier18_11@13-14">Ecce ego.</quote>
            <ref xml:id="gom-ier18-Rd1e166"><name xml:id="gom-ier18-Nd1e167" ref="#Jerome">HIER.</name></ref>
            <quote xml:id="gom-ier18-Qd1e170">Implet parabolam quam et aspectu docuit et sermone.</quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e175">
          <head xml:id="gom-ier18-Hd1e177">Versus 12</head>
          <p xml:id="gom-ier18-d1e179">
            <quote xml:id="gom-ier18-Qd1e181" type="lemma" source="http://scta.info/resource/ier18_12@4-5">Post cogitationes.</quote>
            <ref xml:id="gom-ier18-Rd1e184"><name xml:id="gom-ier18-Nd1e185" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-ier18-Qd1e188"><seg type="qs">Ubi est absque gratia Dei</seg>, etc., usque ad <seg type="qs">omnes in circumitu ejus nationes.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e197">
          <head xml:id="gom-ier18-Hd1e199">Versus 14</head>
          <p xml:id="gom-ier18-d1e201">
            <quote xml:id="gom-ier18-Qd1e203" type="lemma" source="http://scta.info/resource/ier18_14@1-4">Nunquid de petra:</quote>
            <quote xml:id="gom-ier18-Qd1e206"><seg type="qs">quasi diceret: Sicut de Libani summitatibus</seg>, etc., usque ad <seg type="qs">populus meus oblitus est mei.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e215">
          <head xml:id="gom-ier18-Hd1e217">Versus 16</head>
          <p xml:id="gom-ier18-d1e219">
            <quote xml:id="gom-ier18-Qd1e221" type="lemma" source="http://scta.info/resource/ier18_16@1-3">Ut fieret terra.</quote>
            <ref xml:id="gom-ier18-Rd1e224"><name xml:id="gom-ier18-Nd1e225" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-ier18-Qd1e228">Hoc plenius post adventum Domini videtur esse completum, quando nullus Judaeorum terram et urbem sanctam ingredi ege permittitur. Sed cum ad planctum venerint, mirantur et deflent vaticinia prophetarum completa.</quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e232">
          <head xml:id="gom-ier18-Hd1e234">Versus 17</head>
          <p xml:id="gom-ier18-d1e236">
            <pb ed="#P" n="0035B"/>
            <quote xml:id="gom-ier18-Qd1e240" type="lemma" source="http://scta.info/resource/ier18_17@1-2">Sicut ventus.</quote>
            <ref xml:id="gom-ier18-Rd1e243"><name xml:id="gom-ier18-Nd1e244" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-ier18-Qd1e247">Usque hodie haec sententia permanet, etc., <quote xml:id="gom-ier18-Qd1e249">usque ad tunc omnis Israel salvus fiet.</quote></quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e253">
          <head xml:id="gom-ier18-Hd1e255">Versus 18</head>
          <p xml:id="gom-ier18-d1e257">
            <quote xml:id="gom-ier18-Qd1e259" type="lemma" source="http://scta.info/resource/ier18_18@3-3">Venit.</quote>
            <ref xml:id="gom-ier18-Rd1e262"><name xml:id="gom-ier18-Nd1e263" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-ier18-Qd1e266"><seg type="qs">Ista tunc Judaeorum contra Jeremiam vel Christum</seg>, etc., usque ad <seg type="qs">prophetiam omni verborum et sensuum confidentia persequentes.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e275">
          <head xml:id="gom-ier18-Hd1e277">Versus 19</head>
          <p xml:id="gom-ier18-d1e279">
            <quote xml:id="gom-ier18-Qd1e281" type="lemma" source="http://scta.info/resource/ier18_19@1-9">Attende, Domine, ad me, et audi vocem adversariorum meorum.</quote>
            <ref xml:id="gom-ier18-Rd1e284"><name xml:id="gom-ier18-Nd1e285" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-ier18-Qd1e288">In typo Salvatoris, etc., <quote xml:id="gom-ier18-Qd1e290" source="http://scta.info/resource/mt27_25@6-13">usque ad sanguis ejus super nos et super filios nostros</quote>.</quote>
          </p>
        </div>
        <div xml:id="gom-ier18-Dd1e297">
          <head xml:id="gom-ier18-Hd1e299">Versus 23</head>
          <p xml:id="gom-ier18-d1e301">
            <quote xml:id="gom-ier18-Qd1e303" type="lemma" source="http://scta.info/resource/ier18_23@12-15">Ne propitieris iniquitati eorum,</quote>
            etc. <quote xml:id="gom-ier18-Qd1e306"><seg type="qs">Non est contrarium superiori sententiae</seg>, etc., usque ad <seg type="qs">ne inultum peccatum illis fieret in exemplum.</seg></quote>
          </p>
        </div>
      </div>
    </body>
