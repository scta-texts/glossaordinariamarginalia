    <body>
      <div xml:id="gom-ios16">
        <head xml:id="gom-ios16-Hd1e98">Caput 16</head>
        <div xml:id="gom-ios16-Dd1e100">
          <head xml:id="gom-ios16-Hd1e102">Versus 1</head>
          <p xml:id="gom-ios16-d1e104">
            <quote xml:id="gom-ios16-Qd1e106" type="lemma" source="http://scta.info/resource/ios16_1@1-1">Cecidit,</quote>
            etc.
            <ref xml:id="gom-ios16-Rd1e109"><name xml:id="gom-ios16-Nd1e110" ref="#Augustine">AUG.</name>, quaest. 19 in Jos.</ref>
            <quote xml:id="gom-ios16-Qd1e114"><pb ed="#P" n="0518D"/> Sequitur.</quote>
          </p>
        </div>
        <div xml:id="gom-ios16-Dd1e120">
          <head xml:id="gom-ios16-Hd1e122">Versus 10</head>
          <p xml:id="gom-ios16-d1e124">
            <quote xml:id="gom-ios16-Qd1e126" type="lemma" source="http://scta.info/resource/ios16_10@11-12">Habitavitque Chananaeus.</quote>
            <quote xml:id="gom-ios16-Qd1e129"><seg type="qs">Et habitabat Chananaeus in Ephrem</seg>, etc., usque ad <seg type="qs">Unde apparet a LXX interpositum, qui factum esse noverant.</seg></quote>
          </p>
          <p xml:id="gom-ios16-d1e137">
            <ref xml:id="gom-ios16-Rd1e139" type="lemma" subtype="implied" target="http://scta.info/resource/ios16_10@11-12"/>
            <ref xml:id="gom-ios16-Rd1e141"><name xml:id="gom-ios16-Nd1e142" ref="#GregoryGreat">GREG.</name>, lib. IV Moral., c. 22.</ref>
            <quote xml:id="gom-ios16-Qd1e146"><seg type="qs">Chananaeus, gentilis scilicet populus</seg> etc., usque ad <seg type="qs">quod ex se majora non subigit.</seg></quote>
          </p>
          <p xml:id="gom-ios16-d1e154">
            <ref xml:id="gom-ios16-Rd1e156" type="lemma" subtype="implied" target="http://scta.info/resource/ios16_10@11-12"/>
            <ref xml:id="gom-ios16-Rd1e158"><name xml:id="gom-ios16-Nd1e159" ref="#Origen">ADAM.</name>, hom. 21 in Jos.</ref>
            <quote xml:id="gom-ios16-Qd1e163"><seg type="qs">Ephrem interpretatur <mentioned>fructificatio</mentioned></seg>, etc., usque ad <seg type="qs">Subjecit Chananaeos filiis Ephrem.</seg></quote>
          </p>
        </div>
      </div>
    </body>
