    <body>
      <div xml:id="gom-ios19">
        <head xml:id="gom-ios19-Hd1e98">Caput 19</head>
        <div xml:id="gom-ios19-Dd1e100">
          <head xml:id="gom-ios19-Hd1e102">Versus 1</head>
          <p xml:id="gom-ios19-d1e104">
            <quote xml:id="gom-ios19-Qd1e106" type="lemma" source="http://scta.info/resource/ios19_1@6-6">Filiorum.</quote>
            <ref xml:id="gom-ios19-Rd1e109"><name xml:id="gom-ios19-Nd1e110" ref="#Augustine">AUG.</name>, quaest. 20 in Jos.</ref>
            <quote xml:id="gom-ios19-Qd1e114"><seg type="qs">Et Amorrhaeus permansit ut habitaret in Elon</seg>, etc., usque ad <seg type="qs">quod ille non faceret.</seg></quote>
          </p>
          <p xml:id="gom-ios19-d1e122">
            <ref xml:id="gom-ios19-Rd1e124" type="lemma" subtype="implied" target="http://scta.info/resource/ios19_1@6-6"/>
            <ref xml:id="gom-ios19-Rd1e126"><name xml:id="gom-ios19-Nd1e127" ref="#Origen">ADAM.</name>, hom. 24 in Jos.</ref>
            <quote xml:id="gom-ios19-Qd1e131"><seg type="qs">Juxta LXX mansit Amorrhaeus habitare in Elon et in Sannanim</seg>, etc., usque ad <seg type="qs">Et abierunt filii Ephrem peragrare terram secundum fines suos.</seg></quote>
          </p>
        </div>
        <div xml:id="gom-ios19-Dd1e140">
          <head xml:id="gom-ios19-Hd1e142">Versus 49</head>
          <p xml:id="gom-ios19-d1e144">
            <quote xml:id="gom-ios19-Qd1e146" type="lemma" source="http://scta.info/resource/ios19_49@1-1">Cumque.</quote>
            <ref xml:id="gom-ios19-Rd1e149"><name xml:id="gom-ios19-Nd1e150" ref="#Origen">ADAM.</name>, hom. 24.</ref>
            <quote xml:id="gom-ios19-Qd1e154"><seg type="qs">Vide mansuetudinem et humilitatem Jesu</seg>, etc., usque ad <seg type="qs">ut <pb ed="#P" n="0519C"/> libenter Dominus Jesus introeat cordis nostri hospitium.</seg></quote>
          </p>
        </div>
      </div>
    </body>
