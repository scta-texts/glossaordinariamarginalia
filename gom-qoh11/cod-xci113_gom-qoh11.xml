    <body>
      <div xml:id="gom-qoh11">
        <head xml:id="gom-qoh11-Hd1e98">Caput 11</head>
        <div xml:id="gom-qoh11-Dd1e100">
          <head xml:id="gom-qoh11-Hd1e102">Versus 1</head>
          <p xml:id="gom-qoh11-d1e104">
            <pb ed="#P" n="1125C"/>
            <quote xml:id="gom-qoh11-Qd1e108" type="lemma" source="http://scta.info/resource/qoh11_1@1-2">Mitte panem.</quote>
            Aptos fructificationi.
          </p>
        </div>
        <div xml:id="gom-qoh11-Dd1e113">
          <head xml:id="gom-qoh11-Hd1e115">Versus 2</head>
          <p xml:id="gom-qoh11-d1e117">
            <quote xml:id="gom-qoh11-Qd1e119" type="lemma" source="http://scta.info/resource/qoh11_2@1-3">Da partes septem.</quote>
            <ref xml:id="gom-qoh11-Rd1e122"><name xml:id="gom-qoh11-Nd1e123" ref="#Jerome">HIER.</name></ref>
            <quote xml:id="gom-qoh11-Qd1e126">Vetus Testamentum, cujus septima dies, scilicet sabbatum, praecipue honoratur;</quote>
          </p>
          <p xml:id="gom-qoh11-d1e129">
            <quote xml:id="gom-qoh11-Qd1e131" type="lemma" source="http://scta.info/resource/qoh11_2@4-6">necnon et octo,</quote>
            quod est novum; sine altero enim non valet alterum.
          </p>
        </div>
        <div xml:id="gom-qoh11-Dd1e136">
          <head xml:id="gom-qoh11-Hd1e138">Versus 3</head>
          <p xml:id="gom-qoh11-d1e140">
            <quote xml:id="gom-qoh11-Qd1e142" type="lemma" source="http://scta.info/resource/qoh11_3@9-16">Si ceciderit lignum ad austrum, aut ad aquilonem,</quote>
            <ref xml:id="gom-qoh11-Rd1e145"><name xml:id="gom-qoh11-Nd1e146" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-qoh11-Qd1e149">quasi diceret: Locum quem hic tibi praeparaveris, in futuro habebis.</quote>
          </p>
        </div>
        <div xml:id="gom-qoh11-Dd1e153">
          <head xml:id="gom-qoh11-Hd1e155">Versus 4</head>
          <p xml:id="gom-qoh11-d1e157">
            <quote xml:id="gom-qoh11-Qd1e159" type="lemma" source="http://scta.info/resource/qoh11_4@1-5">Qui observat ventum, non seminat.</quote>
            <ref xml:id="gom-qoh11-Rd1e162"><name xml:id="gom-qoh11-Nd1e163" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-qoh11-Qd1e166">Ac si dicat: Omnipotenti te tribue, vel corporale solatium, vel Dei verbum (ne forte praetereas eum qui dignus est accipere); et omni tempore.</quote>
          </p>
          <p xml:id="gom-qoh11-d1e169">
            <quote xml:id="gom-qoh11-Qd1e171" type="lemma" source="http://scta.info/resource/qoh11_4@1-3">Qui observat ventum.</quote>
            In media tempestate seminandum <pb ed="#P" n="1125D"/> est, quia nescimus quae sit voluntas spiritus, et hoc est, <quote xml:id="gom-qoh11-Qd1e176" source="http://scta.info/resource/qoh11_5@1-1">Quomodo,</quote> etc.
          </p>
        </div>
        <div xml:id="gom-qoh11-Dd1e182">
          <head xml:id="gom-qoh11-Hd1e184">Versus 6</head>
          <p xml:id="gom-qoh11-d1e186">
            <quote xml:id="gom-qoh11-Qd1e188" type="lemma" source="http://scta.info/resource/qoh11_6@1-3">Mane semina semen tuum,</quote>
            etc.
            <ref xml:id="gom-qoh11-Rd1e191"><name xml:id="gom-qoh11-Nd1e192" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-qoh11-Qd1e195"><pb ed="#P" n="1126A"/> Omni tempore, scilicet a mane in vesperum, et e converso: vel in pueritia et in senectute. <quote xml:id="gom-qoh11-Qd1e198">Qui enim perseverat, salvabitur.</quote></quote>
          </p>
        </div>
        <div xml:id="gom-qoh11-Dd1e202">
          <head xml:id="gom-qoh11-Hd1e204">Versus 9</head>
          <p xml:id="gom-qoh11-d1e206">
            <quote xml:id="gom-qoh11-Qd1e208" type="lemma" source="http://scta.info/resource/qoh11_9@1-3">Laetare ergo juvenis,</quote>
            etc.
            <ref xml:id="gom-qoh11-Rd1e211"><name xml:id="gom-qoh11-Nd1e212" ref="#Jerome">ID.</name></ref>
            <quote xml:id="gom-qoh11-Qd1e215"><seg type="qs">Hinc usque ad finem libri</seg>, etc., usque ad <seg type="qs">se judicandos sciant.</seg></quote>
          </p>
        </div>
      </div>
    </body>
